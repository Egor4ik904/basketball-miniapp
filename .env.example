# Образец файла с настройками.
#
# Как пользоваться: скопируй этот файл рядом под именем .env и заполни значения.
# Сам .env в репозиторий не попадёт — он перечислен в .gitignore. А этот образец
# отслеживается, чтобы всегда было видно, какие настройки нужны приложению.
#
# В PowerShell скопировать можно так:
#     Copy-Item .env.example .env


# Токен бота, выдаётся @BotFather при создании (команда /newbot).
# Выглядит примерно так: 1234567890:AAF-abcdefghijklmnopqrstuvwxyz
# Это пароль от бота: кто им владеет, тот управляет ботом. Никому не показывай
# и не вставляй в код.
BOT_TOKEN=

# Секретная строка для проверки, что запрос к вебхуку пришёл действительно
# от Telegram, а не от постороннего. Придумай любую случайную —
# например, сгенерируй в PowerShell:
#     python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# Адрес, по которому приложение доступно из интернета.
# Локально можно оставить пустым; на сервере Render подставит свой,
# вида https://имя-сервиса.onrender.com
PUBLIC_URL=
