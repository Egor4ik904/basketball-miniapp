# ===== Виртуальное окружение =====
.venv/
venv/
env/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===== Секреты =====
# .env содержит токен бота — в репозиторий он попасть не должен.
# Список нужных переменных лежит в .env.example, он как раз отслеживается.
.env
.env.local

# ===== База данных =====
# basketball.db — это кеш: команды, матчи, новости. Всё собирается заново
# из источников при первом запуске, поэтому хранить её в репозитории незачем,
# да и весит она немало.
*.db
*.db-journal
*.sqlite3

# ===== Сырые ответы источников из скриптов-разведчиков =====
docs/sources_raw/

# ===== PyCharm =====
.idea/

# ===== Windows и macOS =====
Thumbs.db
desktop.ini
.DS_Store